# Local padrao
AUTH_LOGIN=admin
AUTH_PASSWORD=123456

# SQLite local
DB_CLIENT=sqlite
SQLITE_FILE=server/data/app.sqlite

# Supabase/Postgres em producao (Vercel)
# DB_CLIENT=postgres
# DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEUPROJETO.supabase.co:5432/postgres
# POSTGRES_URL=postgresql://postgres:SUA_SENHA@db.SEUPROJETO.supabase.co:5432/postgres
# POSTGRES_PRISMA_URL=postgresql://postgres:SUA_SENHA@db.SEUPROJETO.supabase.co:5432/postgres
# POSTGRES_SSL=require

# Supabase frontend publico, se o app passar a usar o cliente Supabase no navegador
# VITE_SUPABASE_URL=https://SEUPROJETO.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Segredos Supabase apenas no backend/Vercel; nunca colocar no frontend
# SUPABASE_URL=https://SEUPROJETO.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_xxx
